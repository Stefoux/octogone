# Copie ce fichier en .env (jamais versionné) puis remplis les 3 premières valeurs.

# Identifiant du projet : la partie <REF> de https://supabase.com/dashboard/project/<REF>
SUPABASE_PROJECT_REF=
# Mot de passe de la base, choisi à la création du projet
SUPABASE_DB_PASSWORD=
# Jeton personnel : https://supabase.com/dashboard/account/tokens  (bouton "Generate new token")
SUPABASE_ACCESS_TOKEN=

# --- Rempli automatiquement par scripts/supabase_setup.sh, ne pas toucher ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Optionnel : les deux comptes admin (jamais écrits dans un fichier versionné) ---
ADMIN_EMAIL_1=
ADMIN_EMAIL_2=
